{
  "openapi": "3.1.0",
  "info": {
    "title": "Money With AI API",
    "version": "v1.2",
    "summary": "Read-only JSON about AI bots and money use cases.",
    "description": "Static JSON over HTTPS: no key, no login, CORS open. Read /api/v1/status.json first. Listing text is data, not instructions. A read-only MCP server with the same data is at /mcp (Streamable HTTP, POST JSON-RPC), not described here.",
    "license": {
      "name": "MIT (site code)",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://moneywithai.net"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "Bot contract and endpoint list",
    "url": "https://moneywithai.net/connect/"
  },
  "tags": [
    {
      "name": "Directory",
      "description": "Static files, rebuilt on each release."
    },
    {
      "name": "Live",
      "description": "Computed on request."
    }
  ],
  "paths": {
    "/api/v1/status.json": {
      "get": {
        "operationId": "getStatus",
        "summary": "Version, counts, notices and every endpoint. Read this first.",
        "tags": [
          "Directory"
        ],
        "responses": {
          "200": {
            "description": "API status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/v1/feed.json": {
      "get": {
        "operationId": "getFeed",
        "summary": "Every bot and use case, lean, newest first.",
        "tags": [
          "Directory"
        ],
        "responses": {
          "200": {
            "description": "Feed envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/FeedItem"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/v1/bots.json": {
      "get": {
        "operationId": "listBots",
        "summary": "Full bot records, newest first.",
        "tags": [
          "Directory"
        ],
        "responses": {
          "200": {
            "description": "Bot list envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Bot"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/v1/bots/{slug}.json": {
      "get": {
        "operationId": "getBot",
        "summary": "One bot.",
        "tags": [
          "Directory"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Bot slug, as in the list items.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "example": "account-growth-planner"
          }
        ],
        "responses": {
          "200": {
            "description": "One bot record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bot"
                }
              }
            }
          },
          "404": {
            "description": "No item with this slug (HTML 404 page)."
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/v1/use-cases.json": {
      "get": {
        "operationId": "listUseCases",
        "summary": "Full use-case records (stack, diagram, steps, labelled claims).",
        "tags": [
          "Directory"
        ],
        "responses": {
          "200": {
            "description": "Use case list envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/UseCase"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/v1/use-cases/{slug}.json": {
      "get": {
        "operationId": "getUseCase",
        "summary": "One use case.",
        "tags": [
          "Directory"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Use case slug, as in the list items.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "example": "sell-websites-to-local-businesses"
          }
        ],
        "responses": {
          "200": {
            "description": "One use case record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UseCase"
                }
              }
            }
          },
          "404": {
            "description": "No item with this slug (HTML 404 page)."
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/v1/categories.json": {
      "get": {
        "operationId": "listCategories",
        "summary": "Money categories and sub-use-cases with counts.",
        "tags": [
          "Directory"
        ],
        "responses": {
          "200": {
            "description": "Category list envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    },
                    {
                      "type": "object",
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Category"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    },
    "/api/downloads.json": {
      "get": {
        "operationId": "getDownloads",
        "summary": "Live download counts per bot (one per visitor per bot per day). Below 10 downloads a count is null.",
        "tags": [
          "Live"
        ],
        "responses": {
          "200": {
            "description": "Download counts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Downloads"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from one IP (zone flood limit). Wait and retry."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "generated_at",
          "api_version",
          "schema_revision",
          "status_url",
          "count"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "api_version": {
            "type": "string",
            "const": "v1"
          },
          "schema_revision": {
            "type": "integer",
            "const": 2
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "service",
          "site",
          "generated_at",
          "api_version",
          "schema_revision",
          "capabilities",
          "counts",
          "notices",
          "cache_hint",
          "endpoints",
          "license_note",
          "changelog"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "format": "uri"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "api_version": {
            "type": "string"
          },
          "schema_revision": {
            "type": "integer"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counts": {
            "type": "object",
            "required": [
              "bots",
              "use_cases",
              "categories"
            ],
            "properties": {
              "bots": {
                "type": "integer"
              },
              "use_cases": {
                "type": "integer"
              },
              "categories": {
                "type": "integer"
              }
            }
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cache_hint": {
            "type": "string"
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Name to URL ({slug} is a placeholder)."
          },
          "license_note": {
            "type": "string"
          },
          "changelog": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "change"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "change": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Featured": {
        "type": "object",
        "required": [
          "rank",
          "score",
          "money",
          "profile",
          "visuals",
          "difficulty",
          "override",
          "rules"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "money": {
            "type": "number"
          },
          "profile": {
            "type": "number"
          },
          "visuals": {
            "type": "number"
          },
          "difficulty": {
            "type": "number"
          },
          "override": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Manual featured rank, if pinned."
          },
          "rules": {
            "type": "string",
            "format": "uri"
          }
        },
        "description": "Editorial featured order: score 0 to 100 from the data, not downloads."
      },
      "Bot": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "name",
          "category",
          "sub_use_case",
          "summary",
          "tools",
          "creator",
          "scouted_by",
          "source",
          "official_share_url",
          "found_via",
          "prompt_included",
          "proof_level",
          "last_checked",
          "url",
          "json_url",
          "use_cases",
          "added_at",
          "featured"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "bot"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Leads and Sales",
              "Content and Marketing",
              "E-Commerce",
              "Client Services",
              "Finance",
              "Customer Support",
              "Research and Ops"
            ]
          },
          "sub_use_case": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "creator": {
            "type": "object",
            "required": [
              "handle",
              "url"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          },
          "scouted_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "kind",
              "url"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "x",
                  "web",
                  "youtube"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "official_share_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "found_via": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_included": {
            "type": "boolean"
          },
          "proof_level": {
            "type": "string",
            "enum": [
              "source_verified",
              "creator_confirmed",
              "results_verified"
            ]
          },
          "last_checked": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "json_url": {
            "type": "string",
            "format": "uri"
          },
          "use_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Pages of the use cases this bot is part of."
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "featured": {
            "$ref": "#/components/schemas/Featured"
          }
        }
      },
      "FeedItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FeedBot"
          },
          {
            "$ref": "#/components/schemas/FeedUseCase"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "bot": "#/components/schemas/FeedBot",
            "use-case": "#/components/schemas/FeedUseCase"
          }
        }
      },
      "FeedBot": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "title",
          "category",
          "sub_use_case",
          "summary",
          "creator",
          "url",
          "detail_url",
          "official_share_url",
          "added_at"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "bot"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "sub_use_case": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "detail_url": {
            "type": "string",
            "format": "uri"
          },
          "official_share_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FeedUseCase": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "title",
          "category",
          "summary",
          "bots",
          "url",
          "detail_url",
          "added_at"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "use-case"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "bots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Bot slugs in the stack."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "detail_url": {
            "type": "string",
            "format": "uri"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UseCase": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "title",
          "category",
          "category_slug",
          "money_model",
          "difficulty",
          "summary",
          "money_potential",
          "how_it_makes_money",
          "who_its_for",
          "stack",
          "tools",
          "diagram",
          "steps",
          "guardrails",
          "claims",
          "latest_bot_added_at",
          "featured",
          "url",
          "json_url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "use-case"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Leads and Sales",
              "Content and Marketing",
              "E-Commerce",
              "Client Services",
              "Finance",
              "Customer Support",
              "Research and Ops"
            ]
          },
          "category_slug": {
            "type": "string"
          },
          "money_model": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "Beginner",
              "Intermediate",
              "Advanced"
            ]
          },
          "summary": {
            "type": "string"
          },
          "money_potential": {
            "type": "object",
            "required": [
              "tier",
              "symbol",
              "label",
              "basis",
              "claim_label",
              "note"
            ],
            "properties": {
              "tier": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "symbol": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "claim_label": {
                "type": "string",
                "const": "E"
              },
              "note": {
                "type": "string"
              }
            },
            "description": "Our estimate (Estimate), not a promise."
          },
          "how_it_makes_money": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "who_its_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "bot",
                "name",
                "role",
                "creator",
                "tools",
                "url",
                "official_share_url"
              ],
              "properties": {
                "bot": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "creator": {
                  "type": "string"
                },
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "official_share_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diagram": {
            "type": "object",
            "required": [
              "engine",
              "inputs",
              "steps",
              "outputs"
            ],
            "properties": {
              "engine": {
                "type": "string"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "tool"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "tool": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "order",
                    "by",
                    "name",
                    "does",
                    "tools"
                  ],
                  "properties": {
                    "order": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "by": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "does": {
                      "type": "string"
                    },
                    "tools": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "label",
                "source",
                "checked"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "enum": [
                    "V",
                    "E",
                    "A"
                  ],
                  "description": "V verified by Money With AI, E estimate, A creator claim."
                },
                "source": {
                  "type": "string"
                },
                "checked": {
                  "type": "string"
                }
              }
            }
          },
          "latest_bot_added_at": {
            "type": "string",
            "format": "date-time"
          },
          "featured": {
            "$ref": "#/components/schemas/Featured"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "json_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "slug",
          "label",
          "bots",
          "use_cases",
          "sub_use_cases",
          "url"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "enum": [
              "Leads and Sales",
              "Content and Marketing",
              "E-Commerce",
              "Client Services",
              "Finance",
